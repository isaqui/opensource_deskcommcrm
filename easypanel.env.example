# =============================================================================
# DeskcommCRM en EasyPanel — variables para la pestaña "Environment" del
# servicio Compose. Rellena y pega los pares KEY=VALUE en EasyPanel.
# NO subas este archivo con valores reales a git.
# =============================================================================

# --- Tu dominio (con https://, sin barra final) ------------------------------
NEXT_PUBLIC_APP_URL=https://crm.tudominio.com
NEXT_PUBLIC_ADMIN_URL=https://crm.tudominio.com

# --- Supabase (panel: Project Settings › API / Database) ---------------------
# Project URL
NEXT_PUBLIC_SUPABASE_URL=
# anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key (SECRETA)
SUPABASE_SERVICE_ROLE_KEY=
# Connection string: usa "Session pooler" en modo URI (NO "Direct connection",
# que es solo IPv6 y no conecta desde muchos hosts). Reemplaza [YOUR-PASSWORD].
SUPABASE_DB_URL=

# --- IA: OpenRouter ----------------------------------------------------------
OPENROUTER_API_KEY=
# Opcional (audio + RAG). Vacío = esas funciones esperan una clave OpenAI
# cargada luego en IA › Credenciais.
OPENAI_API_KEY=

# --- Secretos generados (corre los comandos y pega el resultado) -------------
# openssl rand -hex 32
INTERNAL_SECRET=
# openssl rand -hex 32
CPF_ENCRYPTION_KEY=
# openssl rand -hex 32
WAHA_BYO_ENCRYPTION_KEY=
# openssl rand -base64 32   (AES-256, DEBE ser base64 de 32 bytes)
AI_CRED_AES_KEY=
# openssl rand -hex 32
IMPERSONATE_COOKIE_SECRET=
# openssl rand -hex 32
LGPD_SIGNING_KEY=
# openssl rand -hex 32   (token compartido entre 'srh' y la app)
SRH_TOKEN=
# openssl rand -hex 16   (placeholder hasta conectar WhatsApp/WAHA)
WAHA_API_KEY=
